[user]
	name = Ian
	email = storzian@gmail.com

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[core]
	editor = code --wait
	excludesFile = ~/.gitignore_global

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	lg = log --oneline --graph --decorate -20
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit

[rerere]
	enabled = true

[diff]
	algorithm = histogram
