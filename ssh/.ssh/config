# ============================================================================
# SSH Config — Managed by GNU stow from ~/dotfiles
# ============================================================================

# GitHub
Host github.com
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519

# Default settings for all hosts
Host *
    AddKeysToAgent yes
    UseKeychain yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
