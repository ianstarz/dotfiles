#!/usr/bin/env bash
# dev-session — create or attach to the main tmux dev environment

SESSION="main"
DIR="${1:-$HOME}"

if tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux attach-session -t "$SESSION"
  exit 0
fi

tmux new-session -d -s "$SESSION" -c "$DIR"
tmux rename-window -t "$SESSION:1" "dev"

# Split right 30% for git panes
tmux split-window -t "$SESSION:1" -h -p 30 -c "$DIR"
# Split right pane vertically for git log / git status
tmux split-window -t "$SESSION:1.2" -v -c "$DIR"

# Git watches
tmux send-keys -t "$SESSION:1.2" "watch -n2 'git status 2>/dev/null || echo \"not a git repo\"'" Enter
tmux send-keys -t "$SESSION:1.3" "watch -n2 'git log --oneline -50 2>/dev/null || echo \"not a git repo\"'" Enter

# Claude in main pane
tmux send-keys -t "$SESSION:1.1" "claude" Enter
tmux select-pane -t "$SESSION:1.1"

tmux attach-session -t "$SESSION"
