#!/usr/bin/env bash
# project-open — fzf project picker with tmux window layout
#
# Lists ~/Projects dirs + GitHub repos. If the project doesn't exist locally,
# clones or creates it. Opens a tmux window with a dev layout.

set -euo pipefail

# Ensure PATH includes homebrew and local bin
export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"

PROJECTS_DIR="$HOME/Projects"
GH_USER="ianstarz"
SESSION="main"

mkdir -p "$PROJECTS_DIR"

# --- Build project list -----------------------------------------------------
local_projects=$(find "$PROJECTS_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null | sort)

remote_projects=$(gh repo list "$GH_USER" --limit 100 --json name --jq '.[].name' 2>/dev/null | sort) || remote_projects=""

projects=$(echo -e "${local_projects}\n${remote_projects}" | sort -u | grep -v '^$')

# Write to temp file so the dynamic reload binding can reference it
tmpfile=$(mktemp)
echo "$projects" > "$tmpfile"
trap "rm -f $tmpfile" EXIT

# --- fzf selection ----------------------------------------------------------
# Dynamically prepend "Create: <query>" as the user types
fzf_out=$(cat "$tmpfile" | fzf \
    --print-query \
    --prompt="  project > " \
    --height=50% \
    --reverse \
    --border \
    --no-info \
    --bind "change:reload(if [ -n '{q}' ]; then echo 'Create: {q}'; fi; cat '$tmpfile')") || true

query=$(echo "$fzf_out" | sed -n '1p')
selected=$(echo "$fzf_out" | sed -n '2p')

# Strip "Create: " prefix if the user selected that option
[[ "$selected" == "Create: "* ]] && selected="${selected#Create: }"

# Fallback: unmatched enter with a typed query
[[ -z "$selected" && -n "$query" ]] && selected="$query"
[[ -z "$selected" ]] && exit 0

PROJECT_PATH="$PROJECTS_DIR/$selected"
WINDOW_NAME="$selected"

# --- Ensure project exists locally ------------------------------------------
if [[ ! -d "$PROJECT_PATH" ]]; then
    if gh repo view "$GH_USER/$selected" &>/dev/null; then
        echo "Cloning $GH_USER/$selected..."
        gh repo clone "$GH_USER/$selected" "$PROJECT_PATH"
    else
        echo "Creating new project: $selected"
        mkdir -p "$PROJECT_PATH"
        git -C "$PROJECT_PATH" init
        git -C "$PROJECT_PATH" checkout -b main

        echo "Creating GitHub repo: $GH_USER/$selected"
        gh repo create "$selected" --private --source="$PROJECT_PATH" --remote=origin
    fi
fi

# --- Open tmux window -------------------------------------------------------

# If window already exists, just switch to it
if tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$WINDOW_NAME"; then
    tmux select-window -t "$SESSION:$WINDOW_NAME"
    exit 0
fi

# Create new window with dev layout
tmux new-window -t "$SESSION" -n "$WINDOW_NAME" -c "$PROJECT_PATH"

# Split right 35% for side panes
tmux split-window -t "$SESSION:$WINDOW_NAME" -h -p 35 -c "$PROJECT_PATH"

# Split right pane into 3 equal horizontal panes
tmux split-window -t "$SESSION:$WINDOW_NAME.2" -v -p 66 -c "$PROJECT_PATH"
tmux split-window -t "$SESSION:$WINDOW_NAME.3" -v -p 50 -c "$PROJECT_PATH"

# Start git watches in the bottom two right panes
tmux send-keys -t "$SESSION:$WINDOW_NAME.3" "watch -n2 'git log --oneline -20'" Enter
tmux send-keys -t "$SESSION:$WINDOW_NAME.4" "watch -n2 'git status'" Enter

# Focus the main left pane
tmux select-pane -t "$SESSION:$WINDOW_NAME.1"
